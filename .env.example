# PORT: The port the HTTP server binds to (default: 3000 in dev/cloud)
PORT=3000

# NODE_ENV: Application environment ('development' or 'production')
NODE_ENV=development

# DATA_DIR: Path to persistent JSON database directory (default: ./data)
DATA_DIR="./data"

# UPLOADS_DIR: Path to secure archival uploads directory (default: ./data/uploads)
UPLOADS_DIR="./data/uploads"

# GEMINI_API_KEY: Optional API key if AI assistance features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
